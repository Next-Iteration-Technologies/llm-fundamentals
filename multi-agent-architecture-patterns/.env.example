# Copy to .env (same folder) and fill in. .env is read by every lab and never committed.
NEXUS_BASE_URL=https://nexus.example.internal/v1
NEXUS_API_KEY=...
NEXUS_MODEL=MODEL-NAME
# Optional. Azure-style gateway API version (default 2024-10-21); set empty for a plain /chat/completions endpoint.
# NEXUS_API_VERSION=2024-10-21
