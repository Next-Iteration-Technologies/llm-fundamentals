{
  "about": "Golden questions for the Contoso Water RAG lab (fictional). expected_ids refer to corpus-index.json chunk ids, graded 3 = the answer, 2 = needed, 1 = useful background. expected_files are paths inside contoso-pack. must_say are facts the answer has to contain, must_not_say what it must never say. asker is the role the question is asked as (employee, hr, client). should_refuse: the documents don't answer it (or not for this asker).",
  "questions": [
    {
      "id": "g01",
      "flow": "7.2",
      "question": "Why did we drop ClearSpring?",
      "asker": "employee",
      "expected_ids": {
        "c01": 3,
        "c02": 3,
        "c03": 1
      },
      "expected_files": [
        "minutes/2026-10-01.md",
        "mail/2026-09-30_mark_re-re-re-clearspring-utrecht.eml",
        "minutes/2026-09-03.md"
      ],
      "must_say": [
        "cannot deliver to Utrecht before next year"
      ],
      "must_not_say": [
        "too expensive"
      ],
      "note": "The decision is in the minutes, the reason in the last mail of a thread with stacked quoted replies. Price is a plausible but wrong reason."
    },
    {
      "id": "g02",
      "flow": "7.2",
      "question": "A client says the water from their cooler tastes odd. What do we do?",
      "asker": "employee",
      "expected_ids": {
        "c04": 3,
        "c05": 3
      },
      "expected_files": [
        "policies/SV-HYG-01.md",
        "policies/SV-SLA-01.md"
      ],
      "must_say": [
        "deep clean",
        "2 working days"
      ]
    },
    {
      "id": "g03",
